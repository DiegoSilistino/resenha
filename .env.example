# Copie para .env e preencha (usado pelo docker-compose.yml em produção).

# Domínio que aponta para o IP do servidor (registro DNS do tipo A).
DOMAIN=resenha.seudominio.com.br
PUBLIC_URL=https://resenha.seudominio.com.br

# Credenciais do LiveKit. O segredo precisa ter 32+ caracteres; gere com:
#   openssl rand -base64 48
LIVEKIT_API_KEY=resenha
LIVEKIT_API_SECRET=

# Opcional: nível de log (info, warn, error, debug)
# LOG_LEVEL=info

# Opcional: GIFs no chat. Chave grátis em https://developers.giphy.com (Create an API Key).
# Sem ela, o botão de GIF simplesmente não aparece.
# GIPHY_API_KEY=
